# AI Command Center environment.
# Create your real .env with:  scripts/init-env.sh   (fills in random secrets)
# Never commit .env.

# development | production
ACC_ENV=development

# Exact origin the browser uses. Must match for login to work (CSRF origin check).
# If you change ACC_HTTP_PORT, include the port here, e.g. http://localhost:8080
ACC_PUBLIC_ORIGIN=http://localhost

# Caddy site address. ":80" = plain HTTP on any host (dev). Production: your host name.
ACC_SITE_ADDRESS=:80
ACC_HTTP_PORT=80
ACC_HTTPS_PORT=443

ACC_LOG_LEVEL=INFO

# Dev-only host ports (compose.dev.yml), bound to 127.0.0.1.
ACC_PG_PORT=5432
ACC_REDIS_PORT=6379

# ─── Secrets (generated by scripts/init-env.sh) ─────────────────────────────
POSTGRES_PASSWORD=change-me
ACC_OWNER_DB_PASSWORD=change-me
ACC_APP_DB_PASSWORD=change-me
REDIS_PASSWORD=change-me
ACC_SESSION_SECRET=change-me-to-at-least-32-random-characters
# Separate from ACC_SESSION_SECRET on purpose (PLAN-PHASE-2-M2.md §2.4): a leak of one
# must not compromise the other. Signs the per-run token the sandboxed runner container
# uses to call back into the internal API — the runner gets no other credential.
ACC_RUNNER_TOKEN_SECRET=change-me-to-at-least-32-random-characters

# ─── Optional: repository access and the Claude Agent SDK (Phase 2 M3/M4) ───────
# Leave both unset for a deployment that has never linked a real repository or enabled a
# real agent adapter (acc.commands.seed keeps every agent at adapter='none' until an
# operator deliberately changes one). Neither is ever written to a git remote URL,
# git config, or a container image — both are injected into a runner container's
# environment only for the one run that needs them (PLAN-PHASE-2-M3.md §2.2/§2.3,
# PLAN-PHASE-2-M4.md §4.4).
# ACC_GIT_CREDENTIAL=
# ACC_ANTHROPIC_API_KEY=
# ACC_RUN_MAX_TURNS=30
# ACC_RUN_MAX_WALL_CLOCK_MINUTES=15
# ACC_RUN_MAX_COST_USD=2.00
# ACC_RUN_TIMEOUT_WARNING_FRACTION=0.8
